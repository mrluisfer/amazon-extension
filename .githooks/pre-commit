#!/bin/sh
# Blocks commits that contain credentials. Enabled via `git config core.hooksPath .githooks`
# (done automatically by `pnpm install` through the root "prepare" script).

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# 1. Never commit real env files or key material.
bad_files=$(echo "$staged" | grep -E '(^|/)\.env($|\.)|\.pem$|\.key$|\.crx$' | grep -vE '(^|/)\.env\.example$')
if [ -n "$bad_files" ]; then
  echo "pre-commit: refusing to commit secret files:" >&2
  echo "$bad_files" >&2
  exit 1
fi

# 2. Scan added lines for credential patterns.
#    - postgres URLs with an inline password (placeholders like <password> are allowed)
#    - Neon passwords (npg_...), our API tokens (pt_...), private keys
pattern='postgres(ql)?://[^:/@[:space:]]+:[^<@[:space:]]+@|npg_[A-Za-z0-9]{8,}|pt_[A-Za-z0-9_-]{43}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
hits=$(git diff --cached -U0 --diff-filter=ACM -- . ':(exclude)pnpm-lock.yaml' | grep -E '^\+' | grep -vE '^\+\+\+' | grep -nE "$pattern")
if [ -n "$hits" ]; then
  echo "pre-commit: possible credentials in staged changes:" >&2
  echo "$hits" | cut -c1-160 >&2
  echo "Move them to a git-ignored .env file. Bypass only if this is a false positive: git commit --no-verify" >&2
  exit 1
fi

exit 0

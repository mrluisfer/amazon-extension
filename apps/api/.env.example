NODE_ENV=development
PORT=8787

# Local dev: leave unset. `pnpm dev:api` runs through `neon-env run`, which injects the
# linked Neon branch's DATABASE_URL (and injected values win over this file).
# Production: set it in the host's secret manager — pooled host ("-pooler") with the
# least-privileged app_runtime role. NEVER commit real credentials.
# DATABASE_URL="postgresql://app_runtime:<password>@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Required in production: the published extension origin(s).
# ALLOWED_ORIGINS="chrome-extension://<your-extension-id>"
ALLOWED_ORIGINS=

# Only "true" when running behind a proxy/load balancer you control.
TRUST_PROXY=false

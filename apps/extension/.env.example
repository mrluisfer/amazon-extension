# Base URL of the API. Its origin is added to host_permissions and the CSP.
WXT_API_URL=http://localhost:8787

# Optional. Public key that pins the extension ID for unpacked/zip builds, so it doesn't
# change with the folder path. Generate with: pnpm --filter @repo/extension manifest-key -- <key.pem>
# Leave empty for Chrome Web Store uploads.
WXT_MANIFEST_KEY=

{
  "name": "amazon-extension",
  "private": true,
  "description": "Community-built price history browser extension for Amazon México.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrluisfer/amazon-extension.git"
  },
  "bugs": "https://github.com/mrluisfer/amazon-extension/issues",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@repo/api",
    "dev:extension": "turbo run dev --filter=@repo/extension",
    "build": "turbo run build",
    "release:testers": "pnpm --filter @repo/extension release:testers",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:studio": "pnpm --filter @repo/db db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3",
    "@types/node": "^26.6.5",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}

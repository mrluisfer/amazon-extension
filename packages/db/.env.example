# Owner/migrator role — used only by `pnpm db:migrate`. Never ship to the API runtime.
# Copy to .env (git-ignored) and paste the real value there. NEVER put real credentials in this file.
# Use the direct (non "-pooler") host for migrations.
DATABASE_URL_MIGRATIONS="postgresql://neondb_owner:<password>@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

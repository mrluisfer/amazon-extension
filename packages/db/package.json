    "db:studio": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@repo/shared": "workspace:*",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
